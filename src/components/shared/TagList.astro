---
interface Props {
	tags: string[];
	class?: string;
	size?: "sm" | "md";
	showIcon?: boolean;
}

const { tags, class: className, size = "md", showIcon = true } = Astro.props;

const iconSize = size === "sm" ? "h-4 w-4" : "h-6 w-6";
---

{tags.length > 0 && (
	<div class:list={["tag-list", `tag-list-${size}`, className]}>
		{showIcon && (
			<svg
				aria-hidden="true"
				class:list={["tag-list-icon", iconSize]}
				fill="none"
				focusable="false"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M0 0h24v24H0z" fill="none" stroke="none" />
				<path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
				<path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
				<path d="M6 9h-.01" />
			</svg>
		)}
		{tags.map((tag, i) => (
			<span class="contents">
				<a class="cactus-link inline-block before:content-['#']" data-pagefind-filter="tag" href={`/tags/${tag}/`}>
					<span class="sr-only">View more content with the tag </span>{tag}
				</a>{i < tags.length - 1 && ", "}
			</span>
		))}
	</div>
)}

<style>
	.tag-list {
		display: none;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem;
	}

	@media (min-width: 640px) {
		.tag-list {
			display: flex;
		}
	}

	.tag-list-icon {
		flex-shrink: 0;
	}
</style>
