---
interface Props {
	tags: string[];
	class?: string;
	size?: "sm" | "md";
}

const { tags, class: className, size = "md" } = Astro.props;
---

{tags.length > 0 && (
	<div class:list={["tag-list", `tag-list-${size}`, className]}>
		{tags.map((tag) => (
			<a class="cactus-link inline-block before:content-['#']" href={`/tags/${tag}/`}>
				<span class="sr-only">View more content with the tag </span><span data-pagefind-filter="tag">{tag}</span>
			</a>
		))}
	</div>
)}

<style>
	.tag-list {
		display: none;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	@media (min-width: 640px) {
		.tag-list {
			display: flex;
		}
	}
</style>
