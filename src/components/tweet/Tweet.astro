---
import { type CollectionEntry, render } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import { Icon } from "astro-icon/components";
import LikeButton from "@/components/social/LikeButton.astro";
import LikeCounter from "@/components/social/LikeCounter.astro";
import ViewCounter from "@/components/social/ViewCounter.astro";
import Card from "@/components/ui/Card.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	tweet: CollectionEntry<"tweet">;
};

const { as: Tag = "article", tweet, class: className } = Astro.props;
const { Content } = await render(tweet);

const display_name = tweet.data.title;
---

<Card as={Tag} class={`tweet-card not-prose block ${className || ""}`}>
	<a class="tweet-link-overlay" href={`/tweet/${tweet.id}/`} aria-label={display_name}>
		<span class="sr-only">Read tweet: {display_name}</span>
	</a>

	<div class="tweet-header flex items-center justify-between gap-2">
		<span class="tweet-heading font-semibold text-base">{display_name}</span>
		<div class="tweet-actions flex items-center gap-1 shrink-0">
			<LikeButton slug={tweet.id} content_type="tweet" icon_size="sm" class="tweet-like-btn text-text-muted hover:text-red-500 dark:hover:text-red-400 transition-colors p-2 rounded-full hover:bg-red-500/10" />
			<button
				type="button"
				class="copy-link-btn flex items-center justify-center text-text-muted transition-all p-2 rounded-full active:scale-90"
				data-slug={tweet.id}
				aria-label="Copy link to clipboard"
			>
				<Icon name="lucide:share-2" class="share-icon h-4 w-4 transition-all" />
				<Icon name="lucide:check" class="check-icon h-4 w-4 hidden" />
			</button>
		</div>
	</div>

	<div class="tweet-content prose prose-sm prose-cactus max-w-none px-4 pt-3 [&>p:last-of-type]:mb-0">
		<Content />
	</div>

	<div class="tweet-footer flex items-center px-4 pb-4 pt-3">
		<div class="flex items-center gap-2 text-xs text-text-muted lowercase">
			<time datetime={tweet.data.published.toISOString()}>
				{new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: false }).format(tweet.data.published)}
			</time>
			<span class="text-text-tertiary">•</span>
			<ViewCounter slug={tweet.id} content_type="tweet" format="text" class="text-xs [&_.view-count]:text-xs [&>span]:text-xs" />
			<span class="text-text-tertiary">•</span>
			<LikeCounter slug={tweet.id} content_type="tweet" format="text" class="text-xs [&_.like-count]:text-xs [&>span]:text-xs" />
		</div>
	</div>
</Card>

<style>
	.tweet-card {
		position: relative;
	}

	.tweet-link-overlay {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.tweet-card:hover {
		background-color: color-mix(in srgb, var(--color-accent) 3%, var(--color-global-bg));
	}

	.tweet-header,
	.tweet-content,
	.tweet-footer {
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.tweet-actions {
		pointer-events: auto;
	}

	.tweet-footer {
		font-variant-numeric: tabular-nums;
	}

	:global(.tweet-like-btn) {
		padding: 0.5rem;
	}

	:global(.tweet-like-btn .heart-icon) {
		width: 1rem;
		height: 1rem;
	}

	.copy-link-btn {
		position: relative;
	}

	.copy-link-btn:hover {
		color: var(--color-link);
	}

	.copy-link-btn:hover .share-icon {
		transform: scale(1.15);
	}

	.copy-link-btn.copied {
		color: var(--color-green);
	}

	.copy-link-btn.copied .share-icon {
		display: none;
	}

	.copy-link-btn.copied .check-icon {
		display: block;
		animation: check-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@keyframes check-pop {
		0% { transform: scale(0); }
		100% { transform: scale(1); }
	}
</style>

<script>
	const SITE_URL = import.meta.env.SITE || "https://thuvasooriya.me";

	function init_share_buttons() {
		document.querySelectorAll<HTMLButtonElement>(".copy-link-btn").forEach((button) => {
			if (button.dataset.initialized === "true") return;
			button.dataset.initialized = "true";

			button.addEventListener("click", async (e) => {
				e.preventDefault();
				e.stopPropagation();

				const slug = button.dataset.slug;
				if (!slug) return;

				const tweet_card = button.closest(".tweet-card");
				if (!tweet_card) return;

				const heading_el = tweet_card.querySelector(".tweet-heading");
				const content_el = tweet_card.querySelector(".tweet-content");
				const heading = heading_el?.textContent?.trim() || "";
				const text_content = content_el?.textContent?.trim() || "";
				const tweet_url = `${SITE_URL}/tweet/${slug}/`;
				const share_text = `${heading}\n\n${text_content}\n\n${tweet_url}`;

				try {
					if (navigator.clipboard) {
						await navigator.clipboard.writeText(share_text);
						button.classList.add("copied");
						setTimeout(() => {
							button.classList.remove("copied");
						}, 2000);
					}
				} catch (error) {
					console.error("Failed to copy to clipboard:", error);
				}
			});
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init_share_buttons);
	} else {
		init_share_buttons();
	}

	document.addEventListener("astro:page-load", init_share_buttons);
</script>
