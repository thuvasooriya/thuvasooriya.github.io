---
import HeartIcon from "@/components/icons/HeartIcon.astro";

interface Props {
	slug: string;
	contentType: "post" | "tweet" | "project" | "wiki";
	class?: string;
}

const { slug, contentType, class: className } = Astro.props;
---

<button
	type="button"
	class:list={["floating-action like-action", className]}
	aria-label="Like this content"
	data-action="like"
	data-slug={slug}
	data-type={contentType}
	data-user-likes="0"
>
	<div class="heart-wrapper">
		<HeartIcon id={`floating-${slug}`} size="md" />
		<div class="popup-container"></div>
		<div class="particles-container"></div>
	</div>
</button>

<style>
	.like-action {
		position: relative;
	}

	.heart-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.like-action:hover :global(.heart-icon) {
		transform: scale(1.1);
	}

	.like-action:hover :global(.heart-outline) {
		stroke-width: 2;
	}

	.like-action:active {
		transform: scale(0.95);
	}

	.like-action[data-user-likes="13"] :global(.heart-icon) {
		filter: drop-shadow(0 0 6px var(--color-red)) drop-shadow(0 0 12px var(--color-pink));
		animation: pulse-glow 2s ease-in-out infinite;
	}

	@keyframes pulse-glow {
		0%, 100% {
			filter: drop-shadow(0 0 6px var(--color-red)) drop-shadow(0 0 12px var(--color-pink));
		}
		50% {
			filter: drop-shadow(0 0 10px var(--color-red)) drop-shadow(0 0 20px var(--color-pink));
		}
	}

	.like-action.bounce :global(.heart-icon) {
		animation: heart-bounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@keyframes heart-bounce {
		0% { transform: scale(1); }
		30% { transform: scale(1.3); }
		60% { transform: scale(0.9); }
		100% { transform: scale(1); }
	}

	.popup-container {
		position: absolute;
		top: -0.5rem;
		right: 100%;
		margin-right: 0.25rem;
		pointer-events: none;
		z-index: 10;
	}

	:global(.like-action .like-popup) {
		position: absolute;
		right: 0;
		bottom: 0;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-red);
		white-space: nowrap;
		pointer-events: none;
		animation: popup-float-left 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
	}

	:global(.like-action .like-popup.max-popup) {
		font-size: 0.875rem;
		background: linear-gradient(135deg, var(--color-red), var(--color-pink));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: max-popup-float-left 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}

	@keyframes popup-float-left {
		0% { opacity: 1; transform: translate(0, 0) scale(0.5); }
		50% { opacity: 1; transform: translate(-8px, -8px) scale(1.2); }
		100% { opacity: 0; transform: translate(-16px, -16px) scale(1); }
	}

	@keyframes max-popup-float-left {
		0% { opacity: 1; transform: translate(0, 0) scale(0.5) rotate(10deg); }
		30% { opacity: 1; transform: translate(-6px, -6px) scale(1.4) rotate(-5deg); }
		60% { opacity: 1; transform: translate(-12px, -12px) scale(1.2) rotate(3deg); }
		100% { opacity: 0; transform: translate(-20px, -20px) scale(1) rotate(0deg); }
	}

	.particles-container {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		pointer-events: none;
		z-index: 5;
	}

	:global(.heart-particle) {
		position: absolute;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-red);
		pointer-events: none;
		animation: particle-burst 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}

	@keyframes particle-burst {
		0% { opacity: 1; transform: translate(0, 0) scale(1); }
		100% { opacity: 0; transform: var(--particle-end, translate(20px, -20px)) scale(0); }
	}
</style>
