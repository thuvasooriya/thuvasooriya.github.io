---
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<button
	type="button"
	class:list={["floating-action toc-action", className]}
	aria-label="Toggle table of contents"
	data-action="toggle-toc"
>
	<span class="action-tooltip">contents</span>
	<Icon name="lucide:table-of-contents" class="action-icon" />
</button>

<style>
	.toc-action {
		color: var(--color-primary);
	}

	.toc-action:hover .action-icon {
		filter: drop-shadow(0 0 3px currentColor);
	}
</style>
