---
import type { MarkdownHeading } from "astro";
import LikeButton from "@/components/social/LikeButton.astro";
import BackToTopAction from "./BackToTopAction.astro";
import TOCAction from "./TOCAction.astro";
import TOCSidebar from "./TOCSidebar.astro";

interface Props {
	targetId?: string | undefined;
	showBackToTop?: boolean | undefined;
	showToc?: boolean | undefined;
	headings?: MarkdownHeading[] | undefined;
	like?:
		| {
				slug: string;
				contentType: "post" | "tweet" | "project" | "wiki";
		  }
		| undefined;
}

const {
	targetId = "article-hero",
	showBackToTop = true,
	showToc = false,
	headings = [],
	like,
} = Astro.props;

const hasToc = showToc && headings.length > 0;
---

<div
	class="floating-actions"
	data-target-id={targetId}
	aria-hidden="true"
>
	<div class="floating-actions-container">
		{hasToc && <TOCAction />}
		{like && <LikeButton slug={like.slug} content_type={like.contentType} variant="floating" class="floating-action" />}
		{showBackToTop && <BackToTopAction />}
	</div>
</div>

{hasToc && <TOCSidebar headings={headings} />}

<style>
	.floating-actions {
		position: fixed;
		bottom: 5rem;
		right: 1.5rem;
		z-index: 50;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.5rem);
		transition:
			opacity 0.15s var(--ease-snappy),
			visibility 0.15s var(--ease-snappy),
			transform 0.15s var(--ease-snappy);
	}

	.floating-actions.visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.floating-actions.like-only :global(.back-to-top-action),
	.floating-actions.like-only :global(.toc-action) {
		display: none;
	}

	.floating-actions-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem;
		border-radius: 1.5rem;
		background: linear-gradient(
			145deg,
			color-mix(in oklch, var(--color-primary) 8%, var(--color-surface-0) 60%) 0%,
			color-mix(in oklch, var(--color-accent) 6%, var(--color-surface-0) 55%) 100%
		);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid color-mix(in srgb, var(--color-border-muted) 50%, transparent);
		box-shadow: 0 4px 16px color-mix(in srgb, var(--color-global-text) 8%, transparent);
	}

	:global(.floating-action) {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		background: transparent;
		border: none;
		cursor: pointer;
		transition: transform 0.2s ease;
	}

	:global(.floating-action:hover) {
		transform: scale(1.1);
	}

	:global(.floating-action .action-tooltip) {
		position: absolute;
		right: calc(100% + 0.5rem);
		top: 50%;
		transform: translateY(-50%);
		padding: 0.25rem 0.5rem;
		font-size: 0.75rem;
		font-weight: 500;
		white-space: nowrap;
		color: var(--color-text-heading);
		background: var(--color-surface-2);
		border: 1px solid var(--color-border-default);
		border-radius: 0.25rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}

	:global(.floating-action:hover .action-tooltip) {
		opacity: 1;
		transition-delay: 0.4s;
	}

	:global(.floating-action .action-icon) {
		width: 1.5rem;
		height: 1.5rem;
		transition: filter 0.2s ease, transform 0.2s ease;
	}

	@media (max-width: 640px) {
		.floating-actions {
			bottom: 5rem;
			right: 1rem;
		}

		:global(.floating-action) {
			width: 2.25rem;
			height: 2.25rem;
		}

		:global(.floating-action .action-icon) {
			width: 1.25rem;
			height: 1.25rem;
		}

		:global(.floating-action .action-tooltip) {
			display: none;
		}
	}
</style>

<script>
	class FloatingActionsController {
		private container: HTMLDivElement;
		private targetId: string;
		private observer: IntersectionObserver | null = null;
		private hasScrolledPastHero = false;
		private hasLikeButton: boolean;
		private tocButton: HTMLButtonElement | null;
		private backToTopButton: HTMLButtonElement | null;
		private tocSidebar: HTMLElement | null;
		private lastScrollY = 0;
		private isMobile = false;
		private isScrollable = false;

		constructor(container: HTMLDivElement) {
			this.container = container;
			this.targetId = container.dataset.targetId || "article-hero";
			this.hasLikeButton = !!container.querySelector(".like-button");
			this.tocButton = container.querySelector('[data-action="toggle-toc"]');
			this.backToTopButton = container.querySelector('[data-action="back-to-top"]');
			this.tocSidebar = document.getElementById("toc-sidebar");

			this.init();
		}

		private init() {
			this.isMobile = window.innerWidth < 640;
			this.isScrollable = document.documentElement.scrollHeight > window.innerHeight + 100;

			this.setupVisibility();
			this.setupBackToTop();
			this.setupTOC();
		}

		private setupVisibility() {
			// short content: show like immediately, hide TOC/back-to-top
			if (!this.isScrollable) {
				if (this.hasLikeButton) {
					this.container.classList.add("visible", "like-only");
				}
				return;
			}

			const target = document.getElementById(this.targetId);
			if (!target) return;

			// desktop: intersection-based visibility
			this.observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							if (this.hasScrolledPastHero) {
								this.container.classList.remove("visible");
								this.container.classList.remove("like-only");
							}
						} else {
							this.hasScrolledPastHero = true;
							this.container.classList.remove("like-only");
							if (!this.isMobile) {
								this.container.classList.add("visible");
							}
						}
					});
				},
				{ threshold: 0, rootMargin: "-100px 0px 0px 0px" }
			);

			this.observer.observe(target);

			// mobile: scroll-direction based (like MobileNav)
			if (this.isMobile) {
				this.lastScrollY = window.scrollY;
				window.addEventListener("scroll", this.handleScroll, { passive: true });
			}
		}

		private handleScroll = () => {
			if (!this.hasScrolledPastHero) return;

			const currentScrollY = window.scrollY;
			const isAtTop = currentScrollY < 50;
			const isScrollingUp = currentScrollY < this.lastScrollY;

			if (isAtTop) {
				this.container.classList.remove("visible");
			} else if (isScrollingUp) {
				this.container.classList.add("visible");
			} else {
				this.container.classList.remove("visible");
			}

			this.lastScrollY = currentScrollY;
		};

		private setupBackToTop() {
			if (!this.backToTopButton) return;

			const handler = (e: Event) => {
				e.preventDefault();
				e.stopPropagation();
				window.scrollTo({ behavior: "smooth", top: 0 });
			};

			this.backToTopButton.addEventListener("click", handler);
			this.backToTopButton.addEventListener("touchend", handler, { passive: false });
		}

		private setupTOC() {
			if (!this.tocButton || !this.tocSidebar) return;

			this.tocButton.addEventListener("click", () => {
				const isOpen = this.tocSidebar!.dataset.open === "true";
				this.tocSidebar!.dataset.open = (!isOpen).toString();
				this.tocButton!.setAttribute("aria-expanded", (!isOpen).toString());
			});

			document.addEventListener("click", (e) => {
				if (
					this.tocSidebar!.dataset.open === "true" &&
					!this.tocSidebar!.contains(e.target as Node) &&
					!this.tocButton!.contains(e.target as Node)
				) {
					this.tocSidebar!.dataset.open = "false";
					this.tocButton!.setAttribute("aria-expanded", "false");
				}
			});

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && this.tocSidebar!.dataset.open === "true") {
					this.tocSidebar!.dataset.open = "false";
					this.tocButton!.setAttribute("aria-expanded", "false");
				}
			});
		}

		destroy() {
			if (this.observer) {
				this.observer.disconnect();
				this.observer = null;
			}
			if (this.isMobile) {
				window.removeEventListener("scroll", this.handleScroll);
			}
		}
	}

	const controllers = new Map<HTMLDivElement, FloatingActionsController>();

	function initFloatingActions() {
		document.querySelectorAll<HTMLDivElement>(".floating-actions").forEach((container) => {
			if (controllers.has(container)) return;
			controllers.set(container, new FloatingActionsController(container));
		});
	}

	function cleanupFloatingActions() {
		controllers.forEach((controller) => controller.destroy());
		controllers.clear();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initFloatingActions);
	} else {
		initFloatingActions();
	}

	document.addEventListener("astro:page-load", initFloatingActions);
	document.addEventListener("astro:before-swap", cleanupFloatingActions);
</script>
