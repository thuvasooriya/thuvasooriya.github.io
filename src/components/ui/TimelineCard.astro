---
/**
 * TimelineCard - Timeline display for experience/education
 * Vertical line with bullets, current item highlighted at top
 */
import { Icon } from "astro-icon/components";

interface TimelineItem {
	role?: string | undefined;
	degree?: string | undefined;
	org: string;
	url?: string | undefined;
	period: string;
	current?: boolean | undefined;
}

interface Props {
	title: string;
	icon: string;
	items: TimelineItem[];
	color?: string;
	class?: string;
}

const { title, icon, items, color = "primary", class: className } = Astro.props;
---

<div class:list={["timeline-card", `color-${color}`, className]}>
	<div class="card-header">
		<Icon name={icon} class="header-icon" />
		<span class="header-title">{title}</span>
	</div>

	<div class="timeline">
		{items.map((item, index) => (
			<div class:list={["timeline-item", { "is-current": item.current }]}>
				<div class="timeline-track">
					<div class="timeline-bullet" />
					{index < items.length - 1 && <div class="timeline-line" />}
				</div>
				<div class="timeline-content">
					<div class="item-header">
						<span class="item-title">{item.role || item.degree}</span>
						{item.current && <span class="now-badge">now</span>}
					</div>
					{item.url ? (
						<a href={item.url} class="item-org" target="_blank" rel="noopener">
							{item.org}
						</a>
					) : (
						<span class="item-org">{item.org}</span>
					)}
					<span class="item-period">{item.period}</span>
				</div>
			</div>
		))}
	</div>
</div>

<style>
	.timeline-card {
		--card-color: var(--color-primary);
		padding: 1rem;
		background: color-mix(in srgb, var(--card-color) 6%, transparent);
		border: 1px solid color-mix(in srgb, var(--card-color) 15%, transparent);
		border-radius: var(--card-radius, 0.5rem);
	}

	.timeline-card.color-accent { --card-color: var(--color-accent); }
	.timeline-card.color-variant-1 { --card-color: var(--color-variant-1); }
	.timeline-card.color-variant-2 { --card-color: var(--color-variant-2); }
	.timeline-card.color-variant-3 { --card-color: var(--color-variant-3); }
	.timeline-card.color-variant-4 { --card-color: var(--color-variant-4); }

	.card-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid color-mix(in srgb, var(--card-color) 20%, transparent);
	}

	.header-icon {
		width: 1rem;
		height: 1rem;
		color: var(--card-color);
	}

	.header-title {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--card-color);
	}

	/* timeline */
	.timeline {
		display: flex;
		flex-direction: column;
	}

	.timeline-item {
		display: flex;
		gap: 0.75rem;
	}

	/* vertical track with bullet and line */
	.timeline-track {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 0.75rem;
		flex-shrink: 0;
	}

	.timeline-bullet {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--card-color) 40%, transparent);
		border: 2px solid color-mix(in srgb, var(--card-color) 30%, transparent);
		flex-shrink: 0;
		margin-top: 0.25rem;
	}

	.is-current .timeline-bullet {
		width: 0.625rem;
		height: 0.625rem;
		background: var(--card-color);
		border-color: var(--card-color);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--card-color) 25%, transparent);
	}

	.timeline-line {
		width: 2px;
		flex: 1;
		min-height: 1rem;
		background: color-mix(in srgb, var(--card-color) 20%, transparent);
		margin: 0.25rem 0;
	}

	/* content */
	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		padding-bottom: 0.75rem;
		flex: 1;
		min-width: 0;
	}

	.timeline-item:last-child .timeline-content {
		padding-bottom: 0;
	}

	.item-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.item-title {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-global-text);
	}

	.is-current .item-title {
		color: var(--card-color);
	}

	.now-badge {
		padding: 0.0625rem 0.375rem;
		font-size: 0.5625rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-global-bg);
		background: var(--card-color);
		border-radius: 9999px;
	}

	.item-org {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		text-decoration: none;
	}

	a.item-org {
		color: var(--card-color);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--card-color) 40%, transparent);
		text-underline-offset: 2px;
		transition: text-decoration-color 150ms ease-in-out;
	}

	a.item-org:hover {
		text-decoration-color: var(--card-color);
	}

	.item-period {
		font-size: 0.6875rem;
		color: var(--color-text-muted);
	}
</style>
