---
import { Icon } from "astro-icon/components";

interface Props {
	href: string;
	label: string;
	icon?: "github" | "demo" | "link" | "external";
	external?: boolean;
	class?: string;
}

const { href, label, icon = "link", external = true, class: className } = Astro.props;

const iconMap = {
	github: "mdi:github",
	demo: "mdi:play-circle-outline",
	link: "mdi:link-variant",
	external: "mdi:open-in-new",
};
---

<a
	class:list={["icon-link", className]}
	href={href}
	rel={external ? "noopener noreferrer" : undefined}
	target={external ? "_blank" : undefined}
>
	<Icon name={iconMap[icon]} class="h-4 w-4" aria-hidden="true" />
	{label}
</a>

<style>
	.icon-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		transition: color 0.2s ease;
	}

	.icon-link:hover {
		color: var(--color-accent);
	}
</style>
