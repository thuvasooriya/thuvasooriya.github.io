---
/**
 * NowTile - "What I'm doing now" tile with decorative icon
 * Features large icon flushed to top-right, tag at top-left
 */
import LucideIcon from "@/components/icons/LucideIcon.astro";

interface Props {
	tag?: string | undefined;
	title?: string | undefined;
	description?: string | undefined;
	icon?: string | undefined;
	link?: string | undefined;
	status?: "active" | "halted" | undefined;
	color?: string | undefined;
	class?: string | undefined;
}

const {
	tag,
	title,
	description,
	icon = "lucide:circle",
	link,
	status = "active",
	color = "var(--color-primary)",
	class: className,
} = Astro.props;

const isHalted = status === "halted";
const hasLink = !!link;
const TileTag = hasLink ? "a" : "div";
const tileProps = hasLink ? { href: link } : {};
---

<TileTag
	{...tileProps}
	class:list={[
		"tile tile-now group",
		isHalted ? "tile-halted" : "tile-interactive",
		hasLink && "cursor-pointer",
		className,
	]}
	style={`--tile-color: ${color};`}
>
	<div class="tile-now-icon-wrapper">
		<LucideIcon
			name={icon}
			stroke-width={1.25}
			style={`color: ${color}; width: 100%; height: 100%;`}
		/>
	</div>

	{isHalted && (
		<div class="tile-now-pause-overlay">
			<LucideIcon name="lucide:pause" stroke-width={1.25} fill="currentColor" style={`color: ${color}; width: 100%; height: 100%;`} />
		</div>
	)}

	<div class="tile-now-content">
		{tag && (
			<div class="tile-now-tag-row">
				<span class="tile-now-tag" style={`color: ${color};`}>{tag}</span>
			</div>
		)}
		{title && <h4 class="tile-now-title">{title}</h4>}
		{description && <p class="tile-now-desc">{description}</p>}
	</div>
</TileTag>

<style>
	.tile-now {
		position: relative;
		overflow: hidden;
		min-height: 7rem;
		padding: 1rem;
	}

	.tile-now-icon-wrapper {
		position: absolute;
		top: -0.75rem;
		right: -1.5rem;
		width: 7rem;
		height: 7rem;
		opacity: 0.7;
	}

	.tile-halted .tile-now-icon-wrapper {
		opacity: 0.3;
	}

	.tile-now-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.tile-now-tag-row {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-bottom: 0.5rem;
	}

	.tile-now-pause-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
		opacity: 0.8;
		height: 50%;
		align-self: center;
	}

	.tile-now-tag {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.tile-now-title {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.3;
		margin-bottom: 0.25rem;
	}

	.tile-now-desc {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		line-height: 1.4;
		margin-top: auto;
	}
</style>
