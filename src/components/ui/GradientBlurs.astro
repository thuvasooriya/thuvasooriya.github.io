---
interface Blur {
	color: string;
	size?: string;
	top?: string;
	right?: string;
	bottom?: string;
	left?: string;
	opacity?: number;
}

interface Props {
	blurs?: Blur[];
	animate?: boolean;
}

const default_blurs: Blur[] = [
	{ color: "var(--color-primary)", size: "10rem", top: "0", right: "15%" },
	{ color: "var(--color-variant-6)", size: "9rem", top: "60%", left: "5%", opacity: 0.25 },
	{ color: "var(--color-variant-2)", size: "14rem", top: "25%", right: "0", opacity: 0.3 },
	{ color: "var(--color-accent)", size: "12rem", top: "45%", left: "20%" },
	{ color: "var(--color-variant-3)", size: "10rem", top: "85%", right: "25%" },
];

const { blurs = default_blurs, animate = true } = Astro.props;
---

<div class:list={["gradient-blurs", { "gradient-blurs--animate": animate }]} aria-hidden="true">
	{blurs.map((blur, i) => (
		<div
			class="gradient-blur"
			style={{
				"--blur-color": blur.color,
				"--blur-size": blur.size ?? "10rem",
				"--blur-opacity": blur.opacity ?? 0.5,
				"--blur-top": blur.top ?? "auto",
				"--blur-right": blur.right ?? "auto",
				"--blur-bottom": blur.bottom ?? "auto",
				"--blur-left": blur.left ?? "auto",
				"--blur-delay": `${-i * 2}s`,
			}}
		/>
	))}
</div>

<style>
	.gradient-blurs {
		position: fixed;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}

	.gradient-blur {
		position: absolute;
		border-radius: 50%;
		filter: blur(60px);
		background-color: var(--blur-color);
		width: var(--blur-size);
		height: var(--blur-size);
		opacity: var(--blur-opacity);
		top: var(--blur-top);
		right: var(--blur-right);
		bottom: var(--blur-bottom);
		left: var(--blur-left);
	}

	.gradient-blurs--animate .gradient-blur {
		animation: drift 12s ease-in-out infinite;
		animation-delay: var(--blur-delay);
	}

	@keyframes drift {
		0%, 100% {
			transform: translate(0, 0) scale(1);
		}
		25% {
			transform: translate(10px, -15px) scale(1.02);
		}
		50% {
			transform: translate(-5px, -20px) scale(1.05);
		}
		75% {
			transform: translate(-15px, -10px) scale(1.02);
		}
	}
</style>
