---
interface Props {
	className?: string;
	textColor?: string;
	bgColor?: string;
	cursorColor?: string;
	typingSpeed?: number;
	pauseDuration?: number;
	showLanguage?: boolean;
	paddingX?: string;
	paddingY?: string;
	rounded?: string;
}

const {
	className = "text-xl mb-4",
	textColor = "text-primary",
	bgColor = "",
	cursorColor = "bg-primary",
	typingSpeed = 100,
	pauseDuration = 1000,
	showLanguage = false,
	paddingX = "px-3",
	paddingY = "py-1.5",
	rounded = "rounded-sm",
} = Astro.props;

const greetings = [
	{ language: "english", text: "hello!" },
	{ language: "japanese", text: "こんにちは!" },
	{ language: "tamil", text: "வணக்கம்!" },
	{ language: "sinhala", text: "සුබ දවසක්!" },
	{ language: "french", text: "bonjour!" },
	{ language: "spanish", text: "hola!" },
	{ language: "german", text: "guten tag!" },
	{ language: "italian", text: "ciao!" },
	{ language: "chinese", text: "你好!" },
	{ language: "russian", text: "здравствуйте!" },
	{ language: "arabic", text: "مرحباً!" },
];

const longestGreeting = greetings.reduce((a, b) => (a.text.length > b.text.length ? a : b)).text;
---

<language-greeting
	class={`inline-flex flex-col items-start ${className}`}
	data-greetings={JSON.stringify(greetings)}
	data-typing-speed={typingSpeed}
	data-pause-duration={pauseDuration}
	data-show-language={showLanguage}
>
	<div class={`inline-block ${bgColor} ${paddingX} ${paddingY} ${rounded}`}>
		<div class="greeting-container">
			<span class="greeting-sizer" aria-hidden="true">{longestGreeting}</span>
			<span class={`greeting-text ${textColor}`} data-text><span class={`greeting-cursor ${cursorColor}`} data-cursor></span></span>
		</div>
	</div>
	{showLanguage && <div class="greeting-lang mt-1.5 min-h-[1em] text-center text-xs opacity-70" data-lang />}
</language-greeting>

<script>
	class LanguageGreeting extends HTMLElement {
		#textEl: HTMLElement | null = null;
		#cursorEl: HTMLElement | null = null;
		#langEl: HTMLElement | null = null;
		#greetings: Array<{ language: string; text: string }> = [];
		#typingSpeed = 100;
		#pauseDuration = 1000;
		#showLanguage = false;
		#currentIndex = 0;
		#currentText = "";
		#timeoutId: number | null = null;
		#isRunning = false;

		connectedCallback() {
			this.#init();
		}

		disconnectedCallback() {
			this.#cleanup();
		}

		#init() {
			this.#textEl = this.querySelector("[data-text]");
			this.#cursorEl = this.querySelector("[data-cursor]");
			this.#langEl = this.querySelector("[data-lang]");

			try {
				this.#greetings = JSON.parse(this.dataset.greetings || "[]");
			} catch {
				this.#greetings = [];
			}

			this.#typingSpeed = Number(this.dataset.typingSpeed) || 100;
			this.#pauseDuration = Number(this.dataset.pauseDuration) || 1000;
			this.#showLanguage = this.dataset.showLanguage === "true";

			if (!this.#textEl || !this.#cursorEl || this.#greetings.length === 0) return;

			this.#reset();
			this.#showNextGreeting();
		}

		reinit() {
			this.#cleanup();
			this.#init();
		}

		#cleanup() {
			if (this.#timeoutId) {
				clearTimeout(this.#timeoutId);
				this.#timeoutId = null;
			}
			this.#isRunning = false;
		}

		#reset() {
			this.#cleanup();
			this.#currentIndex = 0;
			this.#currentText = "";
			this.#isRunning = true;
			while (this.#cursorEl?.previousSibling) {
				this.#cursorEl.previousSibling.remove();
			}
		}

		#setBlinking(shouldBlink: boolean) {
			if (this.#cursorEl) {
				this.#cursorEl.dataset.blinking = shouldBlink ? "true" : "false";
			}
		}

		#updateText(text: string) {
			if (!this.#textEl || !this.#cursorEl) return;
			this.#currentText = text;
			this.#cursorEl.previousSibling?.remove();
			if (text) {
				this.#textEl.insertBefore(document.createTextNode(text), this.#cursorEl);
			}
		}

		#typeText(text: string, index = 0) {
			if (!this.#isRunning) return;
			this.#setBlinking(false);
			if (index < text.length) {
				this.#updateText(text.substring(0, index + 1));
				this.#timeoutId = window.setTimeout(() => this.#typeText(text, index + 1), this.#typingSpeed);
			} else {
				this.#setBlinking(true);
				this.#timeoutId = window.setTimeout(() => this.#eraseText(), this.#pauseDuration);
			}
		}

		#eraseText() {
			if (!this.#isRunning) return;
			this.#setBlinking(false);
			if (this.#currentText.length > 0) {
				this.#updateText(this.#currentText.substring(0, this.#currentText.length - 1));
				this.#timeoutId = window.setTimeout(() => this.#eraseText(), this.#typingSpeed / 2);
			} else {
				this.#currentIndex = (this.#currentIndex + 1) % this.#greetings.length;
				this.#timeoutId = window.setTimeout(() => this.#showNextGreeting(), 500);
			}
		}

		#showNextGreeting() {
			if (!this.#isRunning) return;
			const greeting = this.#greetings[this.#currentIndex];
			if (!greeting) return;
			this.#updateText("");
			if (this.#showLanguage && this.#langEl) {
				this.#langEl.textContent = greeting.language;
			}
			this.#typeText(greeting.text);
		}
	}

	customElements.define("language-greeting", LanguageGreeting);

	document.addEventListener("astro:page-load", () => {
		document.querySelectorAll<LanguageGreeting>("language-greeting").forEach((el) => {
			el.reinit();
		});
	});
</script>

<style>
	@keyframes blink {
		from, to { opacity: 0; }
		50% { opacity: 1; }
	}

	.greeting-container {
		display: inline-grid;
		align-items: center;
	}

	.greeting-container > * {
		grid-area: 1 / 1;
		white-space: nowrap;
	}

	.greeting-sizer {
		visibility: hidden;
		pointer-events: none;
	}

	.greeting-text {
		display: inline-flex;
		align-items: center;
	}

	.greeting-cursor {
		display: inline-block;
		width: 2px;
		align-self: stretch;
	}

	.greeting-cursor[data-blinking="true"] {
		animation: blink 0.75s step-end infinite;
	}
</style>
