---
import type { CollectionEntry } from "astro:content";

interface Props {
	logs: CollectionEntry<"project">[];
	projectFolder: string;
	projectTitle?: string;
	currentSlug?: string;
}

const { logs, projectFolder, projectTitle = projectFolder, currentSlug = "" } = Astro.props;

const sortedLogs = [...logs].sort((a, b) => {
	const dateA = a.data.updated;
	const dateB = b.data.updated;
	if (!dateA || !dateB) return 0;
	return dateB.getTime() - dateA.getTime();
});

function getLogSlug(log: CollectionEntry<"project">): string {
	return log.id.replace(`${projectFolder}/`, "");
}

function isActive(logSlug: string): boolean {
	return currentSlug === `${projectFolder}/${logSlug}`;
}

function isProjectIndex(): boolean {
	return currentSlug === projectFolder;
}
---

{logs.length > 0 && (
	<nav class="sidebar project-sidebar" aria-label="Project logs" id="project-sidebar" data-open="false">
		<div class="project-sidebar-content">
			<a
				href={`/project/${projectFolder}/`}
				class:list={["project-title-link", { active: isProjectIndex() }]}
				aria-current={isProjectIndex() ? "page" : undefined}
			>
				{projectTitle}
			</a>
			<ul class="project-logs-list">
				{sortedLogs.map((log) => {
					const logSlug = getLogSlug(log);
					const href = `/project/${projectFolder}/${logSlug}/`;
					const active = isActive(logSlug);

					return (
						<li>
							<a
								href={href}
								class:list={["project-log-link", { active }]}
								aria-current={active ? "page" : undefined}
							>
								{log.data.title}
							</a>
						</li>
					);
				})}
			</ul>
		</div>
	</nav>
)}

<style>
	.project-sidebar {
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--color-accent) 8%, var(--color-global-bg)) 0%,
			color-mix(in srgb, var(--color-accent) 3%, var(--color-global-bg)) 100%
		);
		border: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
		border-radius: 0.5rem;
		overflow: hidden;
	}

	.project-sidebar-content {
		padding: 0.75rem;
	}

	.project-title-link {
		display: block;
		padding: 0.25rem 0.5rem;
		margin-bottom: 0.25rem;
		color: var(--color-accent);
		font-weight: 600;
		font-size: 0.875rem;
		text-decoration: none;
		border-radius: 0.25rem;
		transition: background-color 0.15s ease;
	}

	.project-title-link:hover {
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
	}

	.project-title-link.active {
		background: color-mix(in srgb, var(--color-accent) 15%, transparent);
	}

	.project-logs-list {
		list-style: none;
		padding: 0;
		margin: 0;
		margin-left: 0.75rem;
		padding-left: 0.75rem;
		border-left: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
	}

	.project-log-link {
		display: block;
		padding: 0.25rem 0.5rem;
		color: var(--color-global-text);
		font-size: 0.8125rem;
		text-decoration: none;
		border-radius: 0.25rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.project-log-link:hover {
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		color: var(--color-accent);
	}

	.project-log-link.active {
		background: color-mix(in srgb, var(--color-accent) 15%, transparent);
		color: var(--color-accent);
		font-weight: 500;
	}

	@media (max-width: 1023px) {
		.project-sidebar {
			border-radius: 0;
			border: none;
			background: var(--color-global-bg);
		}

		.project-logs-list {
			border-left-color: color-mix(in srgb, var(--color-global-text) 15%, transparent);
		}
	}
</style>

<script>
function initProjectSidebar() {
	const sidebar = document.getElementById("project-sidebar") as HTMLElement | null;
	if (!sidebar) return;

	const checkVisibility = () => {
		const isMobile = window.innerWidth < 1024;
		if (!isMobile) {
			sidebar.dataset.open = "false";
		}
	};

	checkVisibility();
	window.addEventListener("resize", checkVisibility);

	document.addEventListener("click", (e) => {
		const target = e.target as Node;
		if ((target as Element).closest?.(".mobile-sidebar-trigger")) return;
		if (
			sidebar.dataset.open === "true" &&
			!sidebar.contains(target)
		) {
			sidebar.dataset.open = "false";
		}
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && sidebar.dataset.open === "true") {
			sidebar.dataset.open = "false";
		}
	});
}

initProjectSidebar();
document.addEventListener("astro:after-swap", initProjectSidebar);
</script>
