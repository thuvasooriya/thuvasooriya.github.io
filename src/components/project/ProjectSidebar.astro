---
import type { CollectionEntry } from "astro:content";

interface Props {
	logs: CollectionEntry<"project">[];
	projectFolder: string;
	currentSlug?: string;
}

const { logs, projectFolder, currentSlug = "" } = Astro.props;

const sortedLogs = [...logs].sort((a, b) => {
	const dateA = a.data.updated;
	const dateB = b.data.updated;
	if (!dateA || !dateB) return 0;
	return dateB.getTime() - dateA.getTime();
});

function getLogSlug(log: CollectionEntry<"project">): string {
	return log.id.replace(`${projectFolder}/`, "");
}

function isActive(logSlug: string): boolean {
	return currentSlug === `${projectFolder}/${logSlug}`;
}
---

{logs.length > 0 && (
	<nav class="project-sidebar" aria-label="Project logs" id="project-sidebar" data-open="false">
		<ul class="sidebar-list">
			{sortedLogs.map((log) => {
				const logSlug = getLogSlug(log);
				const href = `/projects/${projectFolder}/${logSlug}/`;
				const active = isActive(logSlug);

				return (
					<li>
						<a
							href={href}
							class:list={["sidebar-link", { active }]}
							aria-current={active ? "page" : undefined}
						>
							{log.data.title}
						</a>
					</li>
				);
			})}
		</ul>
	</nav>
)}

<style>
	.project-sidebar {
		width: var(--layout-sidebar-width);
		flex-shrink: 0;
		position: sticky;
		top: 10rem;
		height: fit-content;
		max-height: calc(100vh - 12rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		transition: top 0.1s ease-out, max-height 0.1s ease-out;
	}

	.sidebar-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.sidebar-link {
		display: block;
		padding: 0.25rem 0.5rem;
		color: var(--color-global-text);
		text-decoration: none;
		border-radius: 0.25rem;
		font-size: 0.8125rem;
		line-height: 1.4;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.sidebar-link:hover {
		background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
		color: var(--color-accent);
	}

	.sidebar-link.active {
		background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
		color: var(--color-accent);
		font-weight: 500;
	}

	@media (max-width: 1023px) {
		.project-sidebar {
			position: fixed;
			left: 0;
			top: 0;
			bottom: 3.5rem;
			height: auto;
			max-height: none;
			width: 16rem;
			padding: 1rem;
			background: var(--color-global-bg);
			border-right: 1px solid var(--color-border-default);
			box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
			z-index: 80;
			transform: translateX(-100%);
			transition: transform 0.3s ease;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			overscroll-behavior: contain;
		}

		.project-sidebar[data-open="true"] {
			transform: translateX(0);
		}

		.sidebar-list {
			flex: 0 1 auto;
			overflow-y: auto;
			overscroll-behavior: contain;
		}
	}
</style>

<script>
function initProjectSidebar() {
	const sidebar = document.getElementById("project-sidebar") as HTMLElement | null;
	if (!sidebar) return;

	const updatePosition = () => {
		if (window.innerWidth < 1024) return;
		
		const navHeight = 80;
		const baseTop = 80;
		const scrollY = window.scrollY;
		const dynamicTop = Math.max(16, baseTop + navHeight - scrollY);
		sidebar.style.top = `${dynamicTop}px`;
		sidebar.style.maxHeight = `${window.innerHeight - dynamicTop - 32}px`;
	};

	updatePosition();
	window.addEventListener("scroll", updatePosition, { passive: true });
	window.addEventListener("resize", updatePosition);

	const checkVisibility = () => {
		const isMobile = window.innerWidth < 1024;
		if (!isMobile) {
			sidebar.dataset.open = "false";
			updatePosition();
		} else {
			sidebar.style.top = "";
			sidebar.style.maxHeight = "";
		}
	};

	checkVisibility();
	window.addEventListener("resize", checkVisibility);

	// close on outside click (mobile)
	document.addEventListener("click", (e) => {
		const target = e.target as Node;
		// don't close if click is on the sidebar toggle button in mobile nav
		if ((target as Element).closest?.(".mobile-sidebar-trigger")) return;
		if (
			sidebar.dataset.open === "true" &&
			!sidebar.contains(target)
		) {
			sidebar.dataset.open = "false";
		}
	});

	// close on escape key (mobile)
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && sidebar.dataset.open === "true") {
			sidebar.dataset.open = "false";
		}
	});
}

initProjectSidebar();
document.addEventListener("astro:after-swap", initProjectSidebar);
</script>
