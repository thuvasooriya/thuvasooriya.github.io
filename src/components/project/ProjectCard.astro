---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
	project: CollectionEntry<"project"> & { slug: string };
}

const { project } = Astro.props;
const { title, description, tags, code, status, demo, github } = project.data;

const status_config: Record<
	string,
	{ label: string; color: string; percent: number; icon: string }
> = {
	init: {
		label: "Initializing",
		color: "var(--color-variant-3)",
		percent: 25,
		icon: "lucide:circle",
	},
	plan: {
		label: "Planning",
		color: "var(--color-variant-0)",
		percent: 50,
		icon: "lucide:book-open",
	},
	exec: { label: "In Progress", color: "var(--color-variant-1)", percent: 75, icon: "lucide:play" },
	hold: { label: "On Hold", color: "var(--color-text-muted)", percent: 100, icon: "lucide:pause" },
	done: { label: "Completed", color: "var(--color-variant-2)", percent: 100, icon: "lucide:check" },
};

const current_status = status ? status_config[status] : null;
const gradient_percent = current_status?.percent ?? 0;
---

<article
	class="project-card group"
	data-status={status}
	style={`--status-color: ${current_status?.color ?? "var(--color-accent)"}; --gradient-percent: ${gradient_percent}%;`}
>
	<a class="card-overlay" href={`/projects/${project.slug}/`} aria-label={title}>
		<span class="sr-only">View project: {title}</span>
	</a>

	<div class="card-header">
		<h2 class="card-title">{title}</h2>
		<div class="card-actions">
			{demo && (
				<a
					class="action-link"
					href={demo}
					rel="noopener noreferrer"
					target="_blank"
					aria-label="View demo"
				>
					<Icon name="lucide:external-link" class="action-icon" />
				</a>
			)}
			{github && (
				<a
					class="action-link"
					href={github}
					rel="noopener noreferrer"
					target="_blank"
					aria-label="View on GitHub"
				>
					<Icon name="ri:github-fill" class="action-icon" />
				</a>
			)}
		</div>
	</div>

	{description && (
		<p class="card-description">{description}</p>
	)}

	{tags && tags.length > 0 && (
		<div class="card-tags">
			{tags.slice(0, 3).map((tag) => (
				<span class="tag">#{tag}</span>
			))}
			{tags.length > 3 && (
				<span class="tag tag-more">+{tags.length - 3}</span>
			)}
		</div>
	)}

	<div class="card-footer">
		<div class="footer-left">
			{code && <span class="project-code">{code}</span>}
			{code && current_status && <span class="dot-separator">·</span>}
			{current_status && (
				<span class="status-badge" title={current_status.label}>
					<Icon name={current_status.icon} class="status-icon" />
				</span>
			)}
		</div>
		<Icon name="lucide:arrow-right" class="arrow-icon" />
	</div>
</article>

<style>
	.project-card {
		--status-color: var(--color-accent);
		--gradient-percent: 0%;
		position: relative;
		display: flex;
		flex-direction: column;
		border-radius: 0.5rem;
		border: 1px solid color-mix(in srgb, var(--status-color) 15%, transparent);
		background: var(--color-card-bg);
		overflow: hidden;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--status-color) 35%, transparent);
		box-shadow: 0 4px 16px color-mix(in srgb, var(--status-color) 10%, transparent);
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--status-color) 35%, transparent);
		box-shadow: 0 4px 16px color-mix(in srgb, var(--status-color) 10%, transparent);
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem 1rem 0;
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.card-title {
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1;
		color: var(--color-global-text);
	}

	.card-actions {
		display: flex;
		align-items: center;
		column-gap: 0.5rem;
		flex-shrink: 0;
		pointer-events: auto;
	}

	.action-link {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-muted);
		transition: color 0.15s ease;
	}

	.action-link:hover {
		color: var(--status-color);
	}

	.action-icon {
		display: block;
		width: 1.125rem;
		height: 1.125rem;
	}

	.card-description {
		padding: 0.5rem 1rem 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		margin-bottom: 0.5rem;
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.tag {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 1rem;
		margin-top: auto;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--status-color) 12%, transparent) 0%,
			color-mix(in srgb, var(--status-color) 8%, transparent) calc(var(--gradient-percent) * 0.7),
			transparent var(--gradient-percent)
		);
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.footer-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.project-code {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--status-color);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.dot-separator {
		color: var(--status-color);
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1;
	}

	.status-badge {
		display: flex;
		align-items: center;
		color: var(--status-color);
		pointer-events: auto;
	}

	.status-icon {
		width: 1rem;
		height: 1rem;
	}

	.arrow-icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--status-color);
		transition: transform 0.2s ease;
	}

	.project-card:hover .arrow-icon {
		transform: translateX(4px);
	}
</style>
