---
import type { CollectionEntry } from "astro:content";

interface Props {
	project: CollectionEntry<"project"> & { slug: string };
}

const { project } = Astro.props;
const { title, description, tags, code, status, demo, github } = project.data;

const status_config: Record<string, { label: string; color: string; percent: number }> = {
	init: { label: "Initializing", color: "var(--color-variant-3)", percent: 25 },
	plan: { label: "Planning", color: "var(--color-variant-0)", percent: 50 },
	exec: { label: "In Progress", color: "var(--color-variant-1)", percent: 75 },
	hold: { label: "On Hold", color: "var(--color-text-muted)", percent: 100 },
	done: { label: "Completed", color: "var(--color-variant-2)", percent: 100 },
};

const current_status = status ? status_config[status] : null;
const gradient_percent = current_status?.percent ?? 0;
---

<article
	class="project-card group"
	data-status={status}
	style={`--status-color: ${current_status?.color ?? "var(--color-accent)"}; --gradient-percent: ${gradient_percent}%;`}
>
	<a class="card-overlay" href={`/projects/${project.slug}/`} aria-label={title}>
		<span class="sr-only">View project: {title}</span>
	</a>

	<div class="card-header">
		<h2 class="card-title">{title}</h2>
		<div class="card-actions">
			{demo && (
				<a
					class="action-link"
					href={demo}
					rel="noopener noreferrer"
					target="_blank"
					aria-label="View demo"
				>
					<svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
						<polyline points="15 3 21 3 21 9" />
						<line x1="10" y1="14" x2="21" y2="3" />
					</svg>
				</a>
			)}
			{github && (
				<a
					class="action-link"
					href={github}
					rel="noopener noreferrer"
					target="_blank"
					aria-label="View on GitHub"
				>
					<svg class="action-icon" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
					</svg>
				</a>
			)}
		</div>
	</div>

	{description && (
		<p class="card-description">{description}</p>
	)}

	{tags && tags.length > 0 && (
		<div class="card-tags">
			{tags.slice(0, 3).map((tag) => (
				<span class="tag">#{tag}</span>
			))}
			{tags.length > 3 && (
				<span class="tag tag-more">+{tags.length - 3}</span>
			)}
		</div>
	)}

	<div class="card-footer">
		<div class="footer-left">
			{code && <span class="project-code">{code}</span>}
			{code && current_status && <span class="dot-separator">·</span>}
			{current_status && (
				<span class="status-badge" title={current_status.label}>
					{status === "init" && (
						<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10" />
						</svg>
					)}
					{status === "plan" && (
						<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
							<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
						</svg>
					)}
					{status === "exec" && (
						<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="5 3 19 12 5 21 5 3" />
						</svg>
					)}
					{status === "hold" && (
						<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="6" y="4" width="4" height="16" />
							<rect x="14" y="4" width="4" height="16" />
						</svg>
					)}
					{status === "done" && (
						<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12" />
						</svg>
					)}
				</span>
			)}
		</div>
		<svg
			class="arrow-icon"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<line x1="5" y1="12" x2="19" y2="12" />
			<polyline points="12 5 19 12 12 19" />
		</svg>
	</div>
</article>

<style>
	.project-card {
		--status-color: var(--color-accent);
		--gradient-percent: 0%;
		position: relative;
		display: flex;
		flex-direction: column;
		border-radius: 0.5rem;
		border: 1px solid color-mix(in srgb, var(--status-color) 15%, transparent);
		background: var(--color-card-bg);
		overflow: hidden;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--status-color) 35%, transparent);
		box-shadow: 0 4px 16px color-mix(in srgb, var(--status-color) 10%, transparent);
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--status-color) 35%, transparent);
		box-shadow: 0 4px 16px color-mix(in srgb, var(--status-color) 10%, transparent);
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem 1rem 0;
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.card-title {
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1;
		color: var(--color-global-text);
	}

	.card-actions {
		display: flex;
		align-items: center;
		column-gap: 0.5rem;
		flex-shrink: 0;
		pointer-events: auto;
	}

	.action-link {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-muted);
		transition: color 0.15s ease;
	}

	.action-link:hover {
		color: var(--status-color);
	}

	.action-icon {
		display: block;
		width: 1.125rem;
		height: 1.125rem;
	}

	.card-description {
		padding: 0.5rem 1rem 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		margin-bottom: 0.5rem;
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.tag {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 1rem;
		margin-top: auto;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--status-color) 12%, transparent) 0%,
			color-mix(in srgb, var(--status-color) 8%, transparent) calc(var(--gradient-percent) * 0.7),
			transparent var(--gradient-percent)
		);
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	.footer-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.project-code {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--status-color);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.dot-separator {
		color: var(--status-color);
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1;
	}

	.status-badge {
		display: flex;
		align-items: center;
		color: var(--status-color);
		pointer-events: auto;
	}

	.status-icon {
		width: 1rem;
		height: 1rem;
	}

	.arrow-icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--status-color);
		transition: transform 0.2s ease;
	}

	.project-card:hover .arrow-icon {
		transform: translateX(4px);
	}
</style>
