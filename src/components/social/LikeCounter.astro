---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"div"> {
	slug: string;
	content_type: "post" | "tweet" | "project" | "wiki";
	format?: "icon" | "text";
}

const { slug, content_type, format = "text", class: className, ...rest } = Astro.props;
---

<div class={`like-counter flex items-center gap-1.5 ${className || ""}`} data-slug={slug} data-type={content_type} {...rest}>
	{
		format === "icon" ? (
			<>
				<Icon name="lucide:heart" class="h-4 w-4 text-zinc-500 dark:text-zinc-400" />
				<span class="like-count text-sm font-medium text-zinc-500 dark:text-zinc-400">0</span>
			</>
		) : (
			<span class="text-sm text-zinc-500 dark:text-zinc-400">
				<span class="like-count font-medium">0</span> likes
			</span>
		)
	}
</div>

<style>
	.like-count {
		font-variant-numeric: tabular-nums;
	}

	@media (prefers-reduced-motion: no-preference) {
		.like-count.updating {
			animation: blink 0.3s ease-in-out;
		}
	}

	@keyframes blink {
		0%, 100% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
	}
</style>

<script>
	import { analytics } from "@/utils/analytics";

	type ContentType = "post" | "tweet" | "project" | "wiki";

	class LikeCounterController {
		private count_el: HTMLSpanElement;
		private slug: string;
		private type: ContentType;

		constructor(wrapper: HTMLElement) {
			this.count_el = wrapper.querySelector(".like-count")!;
			this.slug = wrapper.dataset.slug!;
			this.type = wrapper.dataset.type as ContentType;

			this.init();
		}

		private init() {
			analytics.request_stats(this.type, this.slug, (data) => {
				this.update_count(data.likes);
			});
		}

		private update_count(count: number) {
			this.count_el.classList.add("updating");
			this.count_el.textContent = String(count);
			setTimeout(() => {
				this.count_el.classList.remove("updating");
			}, 300);
		}
	}

	function init_like_counters() {
		document.querySelectorAll<HTMLElement>(".like-counter").forEach((wrapper) => {
			if (wrapper.dataset.initialized === "true") return;
			wrapper.dataset.initialized = "true";
			new LikeCounterController(wrapper);
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init_like_counters);
	} else {
		init_like_counters();
	}

	document.addEventListener("astro:page-load", init_like_counters);
</script>
