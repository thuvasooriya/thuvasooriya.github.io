---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"div"> {
	slug: string;
	content_type: "post" | "tweet" | "project" | "wiki";
	format?: "icon" | "text";
}

const { slug, content_type, format = "icon", class: className, ...rest } = Astro.props;
---

<div class={`view-counter flex items-center gap-1.5 ${className || ""}`} data-slug={slug} data-type={content_type} {...rest}>
	{
		format === "icon" ? (
			<>
				<Icon name="lucide:eye" class="h-5 w-5 text-zinc-500 dark:text-zinc-400" />
				<span class="view-count text-sm font-medium text-zinc-500 dark:text-zinc-400">0</span>
			</>
		) : (
			<span class="text-sm text-zinc-500 dark:text-zinc-400">
				<span class="view-count font-medium">0</span> views
			</span>
		)
	}
</div>

<style>
	.view-count {
		font-variant-numeric: tabular-nums;
	}

	@media (prefers-reduced-motion: no-preference) {
		.view-count.updating {
			animation: blink 0.3s ease-in-out;
		}
	}

	@keyframes blink {
		0%, 100% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
	}
</style>

<script>
	import { analytics, type ContentType } from "@/utils/analytics";

	class ViewCounter {
		private wrapper: HTMLElement;
		private count_el: HTMLSpanElement;
		private slug: string;
		private type: ContentType;
		private has_recorded = false;

		constructor(wrapper: HTMLElement) {
			this.wrapper = wrapper;
			this.count_el = wrapper.querySelector(".view-count")!;
			this.slug = wrapper.dataset.slug!;
			this.type = wrapper.dataset.type as ContentType;

			this.init();
		}

		private init() {
			analytics.request_stats(this.type, this.slug, (data) => {
				this.update_count(data.views);
			});

			// subscribe to cache updates (e.g., after view increment flush)
			analytics.on_update((type, slug, data) => {
				if (type === this.type && slug === this.slug) {
					this.update_count(data.views);
				}
			});

			this.setup_intersection_observer();
		}

		private record_view() {
			if (this.has_recorded) return;
			this.has_recorded = true;
			analytics.record_view(this.type, this.slug);
		}

		private update_count(count: number) {
			if (this.count_el.textContent === String(count)) return;
			this.count_el.classList.add("updating");
			this.count_el.textContent = String(count);
			setTimeout(() => {
				this.count_el.classList.remove("updating");
			}, 300);
		}

		private setup_intersection_observer() {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
							this.record_view();
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.5 },
			);

			observer.observe(this.wrapper);
		}
	}

	function init_view_counters() {
		document.querySelectorAll<HTMLElement>(".view-counter").forEach((wrapper) => {
			if (wrapper.dataset.initialized === "true") return;
			wrapper.dataset.initialized = "true";
			new ViewCounter(wrapper);
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init_view_counters);
	} else {
		init_view_counters();
	}

	document.addEventListener("astro:page-load", init_view_counters);
</script>
