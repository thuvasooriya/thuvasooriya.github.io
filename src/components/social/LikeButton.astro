---
import type { HTMLAttributes } from "astro/types";
import HeartIcon from "@/components/icons/HeartIcon.astro";

interface Props extends HTMLAttributes<"button"> {
	slug: string;
	content_type: "post" | "tweet" | "project" | "wiki";
	variant?: "inline" | "floating";
	icon_size?: "sm" | "md" | "lg";
}

const {
	slug,
	content_type,
	variant = "inline",
	icon_size = variant === "floating" ? "md" : "lg",
	class: className,
	...rest
} = Astro.props;

const is_floating = variant === "floating";
---

<button
	type="button"
	class:list={[
		"like-button",
		{ "like-button--floating": is_floating },
		className,
	]}
	data-slug={slug}
	data-type={content_type}
	data-user-likes="0"
	data-variant={variant}
	aria-label="Like this content"
	{...rest}
>
	<div class="heart-wrapper">
		<HeartIcon id={is_floating ? `floating-${slug}` : slug} size={icon_size} />
		<div class="popup-container"></div>
		<div class="particles-container"></div>
	</div>
</button>

<style>
	.like-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border: none;
		background: transparent;
		cursor: pointer;
		border-radius: 9999px;
		outline: none;
		transition: background 0.2s ease;
		position: relative;
	}

	.like-button--floating {
		padding: 0;
	}

	.like-button:active {
		transform: scale(0.95);
	}

	.heart-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.like-button:hover :global(.heart-icon) {
		transform: scale(1.1);
	}

	.like-button:hover :global(.heart-outline) {
		stroke-width: 2;
	}

	/* max likes state handled by SVG glisten animation in HeartIcon */

	.like-button.bounce :global(.heart-icon) {
		animation: heart-bounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@keyframes heart-bounce {
		0% { transform: scale(1); }
		30% { transform: scale(1.3); }
		60% { transform: scale(0.9); }
		100% { transform: scale(1); }
	}

	/* inline variant: popup floats up */
	.like-button:not(.like-button--floating) .popup-container {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		pointer-events: none;
		z-index: 10;
	}

	.like-button:not(.like-button--floating) :global(.like-popup) {
		position: absolute;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-red);
		white-space: nowrap;
		pointer-events: none;
		animation: popup-float-up 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
	}

	.like-button:not(.like-button--floating) :global(.like-popup.max-popup),
	.like-button:not(.like-button--floating) :global(.like-popup.void-popup),
	.like-button:not(.like-button--floating) :global(.like-popup.poof-popup) {
		font-size: 1rem;
		animation: special-popup-float-up var(--popup-duration, 1.2s) cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}

	.like-button:not(.like-button--floating) :global(.like-popup.max-popup) {
		background: linear-gradient(135deg, var(--color-red), var(--color-pink));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.like-button:not(.like-button--floating) :global(.like-popup.void-popup) {
		color: var(--color-text-primary);
		text-shadow: 0 0 8px var(--color-bg-primary), 0 0 12px var(--color-bg-secondary);
	}

	.like-button:not(.like-button--floating) :global(.like-popup.poof-popup) {
		color: var(--color-text-muted);
		font-style: italic;
	}

	@keyframes popup-float-up {
		0% { opacity: 1; transform: translateY(0) scale(0.5); }
		50% { opacity: 1; transform: translateY(-20px) scale(1.2); }
		100% { opacity: 0; transform: translateY(-35px) scale(1); }
	}

	@keyframes special-popup-float-up {
		0% { 
			opacity: 1; 
			transform: translate(0, 0) scale(0.5) rotate(var(--popup-rot-start, -10deg)); 
		}
		30% { 
			opacity: 1; 
			transform: translate(var(--popup-x-mid, 5px), var(--popup-y-mid, -15px)) scale(var(--popup-scale, 1.4)) rotate(var(--popup-rot-mid, 5deg)); 
		}
		60% { 
			opacity: 1; 
			transform: translate(var(--popup-x-end, 0px), var(--popup-y-end, -25px)) scale(calc(var(--popup-scale, 1.4) * 0.85)) rotate(var(--popup-rot-end, -3deg)); 
		}
		100% { 
			opacity: 0; 
			transform: translate(var(--popup-x-final, 0px), var(--popup-y-final, -40px)) scale(1) rotate(0deg); 
		}
	}

	/* floating variant: popup floats left */
	.like-button--floating .popup-container {
		position: absolute;
		top: -0.5rem;
		right: 100%;
		margin-right: 0.25rem;
		pointer-events: none;
		z-index: 10;
	}

	.like-button--floating :global(.like-popup) {
		position: absolute;
		right: 0;
		bottom: 0;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--color-red);
		white-space: nowrap;
		pointer-events: none;
		animation: popup-float-left 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
	}

	.like-button--floating :global(.like-popup.max-popup),
	.like-button--floating :global(.like-popup.void-popup),
	.like-button--floating :global(.like-popup.poof-popup) {
		font-size: 0.875rem;
		animation: special-popup-float-left var(--popup-duration, 1.2s) cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}

	.like-button--floating :global(.like-popup.max-popup) {
		background: linear-gradient(135deg, var(--color-red), var(--color-pink));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.like-button--floating :global(.like-popup.void-popup) {
		color: var(--color-text-primary);
		text-shadow: 0 0 6px var(--color-bg-primary), 0 0 10px var(--color-bg-secondary);
	}

	.like-button--floating :global(.like-popup.poof-popup) {
		color: var(--color-text-muted);
		font-style: italic;
	}

	@keyframes popup-float-left {
		0% { opacity: 1; transform: translate(0, 0) scale(0.5); }
		50% { opacity: 1; transform: translate(-8px, -8px) scale(1.2); }
		100% { opacity: 0; transform: translate(-16px, -16px) scale(1); }
	}

	@keyframes special-popup-float-left {
		0% { 
			opacity: 1; 
			transform: translate(0, 0) scale(0.5) rotate(var(--popup-rot-start, 10deg)); 
		}
		30% { 
			opacity: 1; 
			transform: translate(var(--popup-x-mid, -6px), var(--popup-y-mid, -6px)) scale(var(--popup-scale, 1.4)) rotate(var(--popup-rot-mid, -5deg)); 
		}
		60% { 
			opacity: 1; 
			transform: translate(var(--popup-x-end, -12px), var(--popup-y-end, -12px)) scale(calc(var(--popup-scale, 1.4) * 0.85)) rotate(var(--popup-rot-end, 3deg)); 
		}
		100% { 
			opacity: 0; 
			transform: translate(var(--popup-x-final, -20px), var(--popup-y-final, -20px)) scale(1) rotate(0deg); 
		}
	}

	/* shared particles */
	.particles-container {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		pointer-events: none;
		z-index: 5;
	}

	:global(.like-button .heart-particle) {
		position: absolute;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-red);
		pointer-events: none;
		animation: particle-burst 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}

	@keyframes particle-burst {
		0% { opacity: 1; transform: translate(0, 0) scale(1); }
		100% { opacity: 0; transform: var(--particle-end, translate(20px, -20px)) scale(0); }
	}
</style>

<script>
	import { LikeController } from "@/utils/like-controller";
	import type { ContentType } from "@/utils/analytics";

	function create_animation_helpers(button: HTMLButtonElement) {
		const popup_container = button.querySelector<HTMLDivElement>(".popup-container");
		const particles_container = button.querySelector<HTMLDivElement>(".particles-container");
		const is_floating = button.dataset.variant === "floating";

		const rand = (min: number, max: number) => Math.random() * (max - min) + min;
		const rand_sign = () => Math.random() > 0.5 ? 1 : -1;

		const show_popup = (text = "+1", type: "normal" | "max" | "void" | "poof" = "normal") => {
			if (!popup_container) return;
			const popup = document.createElement("span");
			const class_map = { normal: "like-popup", max: "like-popup max-popup", void: "like-popup void-popup", poof: "like-popup poof-popup" };
			popup.className = class_map[type];
			popup.textContent = text;

			const is_special = type !== "normal";
			
			if (is_special) {
				const duration = rand(1.0, 1.4);
				const scale = rand(1.2, 1.6);
				const rot_start = rand(5, 15) * rand_sign();
				const rot_mid = rand(3, 8) * -rand_sign();
				const rot_end = rand(2, 5) * rand_sign();
				
				if (is_floating) {
					const x_drift = rand(-25, -40);
					const y_drift = rand(-20, -35);
					popup.style.setProperty("--popup-duration", `${duration}s`);
					popup.style.setProperty("--popup-scale", `${scale}`);
					popup.style.setProperty("--popup-rot-start", `${rot_start}deg`);
					popup.style.setProperty("--popup-rot-mid", `${rot_mid}deg`);
					popup.style.setProperty("--popup-rot-end", `${rot_end}deg`);
					popup.style.setProperty("--popup-x-mid", `${x_drift * 0.5}px`);
					popup.style.setProperty("--popup-y-mid", `${y_drift * 0.5}px`);
					popup.style.setProperty("--popup-x-end", `${x_drift * 0.75}px`);
					popup.style.setProperty("--popup-y-end", `${y_drift * 0.75}px`);
					popup.style.setProperty("--popup-x-final", `${x_drift}px`);
					popup.style.setProperty("--popup-y-final", `${y_drift}px`);
				} else {
					const x_drift = rand(-25, 25);
					const y_travel = rand(50, 70);
					popup.style.left = `${rand(-20, 20)}px`;
					popup.style.top = `${rand(-25, -15)}px`;
					popup.style.setProperty("--popup-duration", `${duration}s`);
					popup.style.setProperty("--popup-scale", `${scale}`);
					popup.style.setProperty("--popup-rot-start", `${rot_start}deg`);
					popup.style.setProperty("--popup-rot-mid", `${rot_mid}deg`);
					popup.style.setProperty("--popup-rot-end", `${rot_end}deg`);
					popup.style.setProperty("--popup-x-mid", `${x_drift * 0.4}px`);
					popup.style.setProperty("--popup-y-mid", `${-y_travel * 0.45}px`);
					popup.style.setProperty("--popup-x-end", `${x_drift * 0.7}px`);
					popup.style.setProperty("--popup-y-end", `${-y_travel * 0.7}px`);
					popup.style.setProperty("--popup-x-final", `${x_drift}px`);
					popup.style.setProperty("--popup-y-final", `${-y_travel}px`);
				}
			} else if (!is_floating) {
				popup.style.left = `${(Math.random() - 0.5) * 20}px`;
				popup.style.top = "0";
			}

			popup_container.appendChild(popup);
			const remove_delay = is_special ? 1400 : 800;
			setTimeout(() => popup.remove(), remove_delay);
		};

		const show_particles = () => {
			if (!particles_container) return;
			for (let i = 0; i < 6; i++) {
				const particle = document.createElement("span");
				particle.className = "heart-particle";
				const angle = (i / 6) * Math.PI * 2;
				const distance = 20 + Math.random() * 10;
				const x = Math.cos(angle) * distance;
				const y = Math.sin(angle) * distance;
				particle.style.setProperty("--particle-end", `translate(${x}px, ${y}px)`);
				particle.style.background = i % 2 === 0 ? "var(--color-red)" : "var(--color-pink)";
				particles_container.appendChild(particle);
				setTimeout(() => particle.remove(), 600);
			}
		};

		return {
			on_animate: () => {
				button.classList.add("bounce");
				setTimeout(() => button.classList.remove("bounce"), 400);
				show_popup();
				show_particles();
			},
			on_shake: () => {
				const heart = button.querySelector<SVGElement>(".heart-icon");
				if (!heart) return;
				heart.style.animation = "none";
				void heart.getBoundingClientRect();
				heart.style.animation = "shake 0.3s ease";
				setTimeout(() => { heart.style.animation = ""; }, 300);
			},
			on_max: () => show_popup("max!", "max"),
			on_void: () => show_popup("void", "void"),
			on_poof: () => show_popup("poof!", "poof"),
		};
	}

	if (!document.getElementById("like-button-keyframes")) {
		const style = document.createElement("style");
		style.id = "like-button-keyframes";
		style.textContent = `
			@keyframes shake {
				0%, 100% { transform: translateX(0); }
				20% { transform: translateX(-3px); }
				40% { transform: translateX(3px); }
				60% { transform: translateX(-2px); }
				80% { transform: translateX(2px); }
			}
		`;
		document.head.appendChild(style);
	}

	function init_like_buttons() {
		document.querySelectorAll<HTMLButtonElement>(".like-button").forEach((button) => {
			if (button.dataset.initialized === "true") return;
			button.dataset.initialized = "true";

			const helpers = create_animation_helpers(button);
			new LikeController({
				button,
				slug: button.dataset.slug!,
				type: button.dataset.type as ContentType,
				...helpers,
			});
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init_like_buttons);
	} else {
		init_like_buttons();
	}

	document.addEventListener("astro:page-load", init_like_buttons);
</script>
