---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/project/ProjectCard.astro";
import ListingLayout from "@/layouts/ListingLayout.astro";
import { filterConfig } from "@/site.config";

const all_proj = await getCollection("project");
const projects = all_proj
	.filter((entry) => !entry.id.includes("/"))
	.map((entry) => ({
		...entry,
		slug: entry.id,
	}))
	.sort((a, b) => {
		if (a.data.started && b.data.started) {
			return b.data.started.getTime() - a.data.started.getTime();
		}
		return a.data.title.localeCompare(b.data.title);
	});

const tag_counts: Record<string, number> = {};
projects.forEach((project) => {
	(project.data.tags || []).forEach((tag: string) => {
		tag_counts[tag] = (tag_counts[tag] || 0) + 1;
	});
});

const all_tags = Object.keys(tag_counts);

const meta = {
	description: "collection of projects, experiments, and learning journeys",
	title: "projects",
};
---

<ListingLayout
	meta={meta}
	title="projects"
	showFilter={all_tags.length > 0}
	filterProps={{
		all_tags,
		min_usage: filterConfig.min_tag_usage,
		tag_counts,
	}}
	gridClass="card-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
>
	{
		projects.map((project) => (
			<div data-filterable-item data-tags={(project.data.tags || []).join(",")}>
				<ProjectCard project={project} />
			</div>
		))
	}
	{
		projects.length === 0 && (
			<p class="text-center text-sm text-zinc-600 dark:text-zinc-400">
				no projects found. create a folder in <code>src/content/project</code> with an <code>
					index.md
				</code> file.
			</p>
		)
	}
</ListingLayout>
