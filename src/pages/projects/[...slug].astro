---
import { type CollectionEntry, getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import ProjectPostLayout from "@/layouts/ProjectPost.astro";

export const getStaticPaths = (async () => {
	const all_proj = await getCollection("proj");

	const project_indexes = all_proj.filter((entry) => !entry.id.includes("/"));

	const articles = all_proj.filter((entry) => entry.id.includes("/"));

	return [
		...project_indexes.map((entry) => ({
			params: { slug: entry.id },
			props: { entry, is_article: false },
		})),
		...articles.map((entry) => ({
			params: { slug: entry.id },
			props: { entry, is_article: true },
		})),
	];
}) satisfies GetStaticPaths;

interface Props {
	entry: CollectionEntry<"proj">;
	is_article: boolean;
}

const { entry, is_article } = Astro.props;
const { Content, headings } = await render(entry);

const project_folder = is_article ? entry.id.split("/")[0] : entry.id;

const all_proj = await getCollection("proj");
const related_articles = is_article
	? []
	: all_proj
			.filter((e) => {
				const folder = e.id.split("/")[0];
				return folder === project_folder && e.id.includes("/");
			})
			.sort((a, b) => {
				const date_a = a.data.date ?? a.data.publishDate;
				const date_b = b.data.date ?? b.data.publishDate;
				if (!date_a || !date_b) return 0;
				return date_b.getTime() - date_a.getTime();
			});
---

<ProjectPostLayout
	entry={entry}
	headings={headings}
	isLog={is_article}
	projectFolder={project_folder}
	relatedLogs={related_articles}
>
	<Content />
</ProjectPostLayout>
