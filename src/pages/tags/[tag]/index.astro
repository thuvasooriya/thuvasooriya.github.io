---
import type { GetStaticPaths } from "astro";
import ContentCard from "@/components/shared/ContentCard.astro";
import FormattedDate from "@/components/shared/FormattedDate.astro";
import AnimateIn from "@/components/ui/AnimateIn.astro";
import { getContentByTag, getGlobalTagNames } from "@/data/content";
import { getProjectCodeMap } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils";

export const getStaticPaths: GetStaticPaths = async () => {
	const tags = await getGlobalTagNames();
	return tags.map((tag) => ({ params: { tag } }));
};

const { tag } = Astro.params;
const content = await getContentByTag(String(tag));
const projectCodeMap = await getProjectCodeMap();

const posts = content.posts.sort(collectionDateSort);
const projects = content.projects.sort((a, b) => {
	const dateA = a.data.started?.getTime() ?? 0;
	const dateB = b.data.started?.getTime() ?? 0;
	return dateB - dateA;
});
const wiki = content.wiki.sort((a, b) => {
	const dateA = a.data.updated?.getTime() ?? 0;
	const dateB = b.data.updated?.getTime() ?? 0;
	return dateB - dateA;
});

const totalCount = posts.length + projects.length + wiki.length;

const meta = {
	description: `all content tagged with ${tag}`,
	title: `#${tag}`,
};
---

<PageLayout meta={meta} pageType="listing">
	<div class="tag-page-header" data-animate>
		<h1 class="sr-only">content with the tag {tag}</h1>
		<a class="title text-accent" href="/tags/">tags</a>
		<span aria-hidden="true" class="sep text-primary">•</span>
		<span class="tag-name">#{tag}</span>
		<span aria-hidden="true" class="sep text-primary">•</span>
		<span class="tag-count">{totalCount}</span>
	</div>

	{posts.length > 0 && (
		<section class="mb-10" data-animate data-delay="1">
			<h2 class="section-heading">
				<span>posts</span>
				<span aria-hidden="true" class="sep text-primary">•</span>
				<span class="section-count">{posts.length}</span>
			</h2>
			<ul class="card-list">
				{posts.map((post) => (
					<li>
						<ContentCard entry={post} />
					</li>
				))}
			</ul>
		</section>
	)}

	{projects.length > 0 && (
		<section class="mb-10" data-animate data-delay="2">
			<h2 class="section-heading">
				<span>projects</span>
				<span aria-hidden="true" class="sep text-primary">•</span>
				<span class="section-count">{projects.length}</span>
			</h2>
			<ul class="card-list">
				{projects.map((project) => (
					<li>
						<ContentCard entry={project} projectCode={projectCodeMap.get(project.id)} />
					</li>
				))}
			</ul>
		</section>
	)}

	{wiki.length > 0 && (
		<section class="mb-10" data-animate data-delay="3">
			<h2 class="section-heading">
				<span>wiki</span>
				<span aria-hidden="true" class="sep text-primary">•</span>
				<span class="section-count">{wiki.length}</span>
			</h2>
			<ul class="space-y-3">
				{wiki.map((entry) => (
					<li class="flex items-baseline gap-3">
						<a
							class="cactus-link font-medium"
							href={`/wiki/${entry.id}/`}
							data-astro-prefetch
						>
							{entry.data.title}
						</a>
						{entry.data.updated && (
							<FormattedDate
								class="text-xs text-text-muted"
								date={entry.data.updated}
							/>
						)}
					</li>
				))}
			</ul>
		</section>
	)}
</PageLayout>

<AnimateIn />

<style>
	.tag-page-header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.tag-name {
		font-size: 1.25rem;
		font-weight: 600;
	}

	.tag-count {
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.sep {
		font-size: 1.25rem;
	}

	.section-heading {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text-muted);
		text-transform: lowercase;
	}

	.section-heading .sep {
		font-size: 1rem;
	}

	.section-count {
		font-size: 0.875rem;
		font-weight: 400;
	}
</style>
