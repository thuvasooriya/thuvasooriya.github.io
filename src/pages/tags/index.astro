---
import AnimateIn from "@/components/ui/AnimateIn.astro";
import { getGlobalTags } from "@/data/content";
import PageLayout from "@/layouts/Base.astro";

const allTags = await getGlobalTags();

const meta = {
	description: "a list of all topics across posts, projects, and wiki",
	title: "all tags",
};

function formatCount(info: { counts: { post: number; project: number; wiki: number } }): string {
	const parts: string[] = [];
	if (info.counts.post > 0)
		parts.push(`${info.counts.post} post${info.counts.post > 1 ? "s" : ""}`);
	if (info.counts.project > 0)
		parts.push(`${info.counts.project} project${info.counts.project > 1 ? "s" : ""}`);
	if (info.counts.wiki > 0) parts.push(`${info.counts.wiki} wiki`);
	return parts.join(", ");
}
---

<PageLayout meta={meta} pageType="listing">
	<h1 class="title mb-6" data-animate>tags</h1>
	<ul class="space-y-4" data-animate data-delay="1">
		{
			allTags.map((info) => (
				<li class="flex items-center gap-x-2">
					<a
						class="cactus-link inline-block"
						data-astro-prefetch
						href={`/tags/${info.tag}/`}
						title={`view content with the tag: ${info.tag}`}
					>
						&#35;{info.tag}
					</a>
					<span class="inline-block text-sm text-text-muted">
						- {formatCount(info)}
					</span>
				</li>
			))
		}
	</ul>
</PageLayout>

<AnimateIn />
