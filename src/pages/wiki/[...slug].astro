---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import TOC from "@/components/content/TOC.astro";
import AnimateIn from "@/components/ui/AnimateIn.astro";
import DocHeader from "@/components/wiki/DocHeader.astro";
import WikiSidebar from "@/components/wiki/WikiSidebar.astro";
import BaseLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const wikiEntries = await getCollection("wiki");
	return wikiEntries
		.filter((entry) => entry.id !== "index")
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const description = entry.data.description;
---

<BaseLayout
	meta={{
		title: entry.data.title,
		...(description && { description }),
	}}
	pageType="wiki"
	hideFooter
>
	<div class="wiki-layout">
		<WikiSidebar currentSlug={entry.id} />
		<article class="wiki-content">
			<header class="wiki-header" data-animate data-animate-immediate>
				<h1>{entry.data.title}</h1>
				{entry.data.description && <p class="wiki-description">{entry.data.description}</p>}
			</header>
			<DocHeader slug={entry.id} status={entry.data.status} updated={entry.data.updated} tags={entry.data.tags} />
			{!!headings.length && <TOC headings={headings} />}
			<div class="prose prose-sm max-w-none" data-animate data-animate-immediate data-delay="1">
				<Content />
			</div>
		</article>
		<div class="wiki-toc-space" aria-hidden="true"></div>
	</div>
	<AnimateIn />
</BaseLayout>
