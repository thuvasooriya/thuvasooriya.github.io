---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import Pagination from "@/components/shared/Paginator.astro";
import Tweet from "@/components/tweet/Tweet.astro";
import ListingLayout from "@/layouts/ListingLayout.astro";
import { collectionDateSort, getPaginationProps } from "@/utils";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_TWEETS_PER_PAGE = 10;
	const all_tweets = await getCollection("tweet");
	return paginate(all_tweets.sort(collectionDateSort), { pageSize: MAX_TWEETS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"tweet">>;
}

const { page } = Astro.props;

const meta = {
	description: "read my collection of tweets",
	title: "tweets",
};

const paginationProps = getPaginationProps(page);
---

<ListingLayout
	meta={meta}
	title="tweets"
	rssUrl="/notes/rss.xml"
	gridClass="card-masonry mt-6"
>
	{page.data.map((tweet) => <Tweet tweet={tweet} as="article" />)}
	<Pagination slot="pagination" {...paginationProps} />
</ListingLayout>
