---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import FloatingActions from "@/components/floating/FloatingActions.astro";
import AnimateIn from "@/components/ui/AnimateIn.astro";
import DocHeader from "@/components/wiki/DocHeader.astro";
import WikiSidebar from "@/components/wiki/WikiSidebar.astro";
import BaseLayout from "@/layouts/Base.astro";

interface Props {
	entry: CollectionEntry<"wiki">;
	headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const description = entry.data.description;
const currentSlug = entry.id === "index" ? "index" : entry.id;
---

<BaseLayout
	meta={{
		title: entry.data.title,
		...(description && { description }),
	}}
	pageType="wiki"
	hideFooter
	sidebarType="wiki"
>
	<div class="wiki-layout">
		<WikiSidebar currentSlug={currentSlug} />
		<article class="wiki-content" data-pagefind-body data-pagefind-filter="content_type:wiki">
			<header class="wiki-header" id="wiki-hero" data-animate data-animate-immediate>
				<h1>{entry.data.title}</h1>
				{entry.data.description && <p class="wiki-description">{entry.data.description}</p>}
			</header>
			<DocHeader
				slug={currentSlug}
				status={entry.data.status}
				updated={entry.data.updated}
				tags={entry.data.tags}
			/>
			<div class="prose prose-sm max-w-none" data-animate data-animate-immediate data-delay="1">
				<slot />
			</div>
		</article>
		<div class="wiki-toc-space" aria-hidden="true"></div>
	</div>
	<FloatingActions
		targetId="wiki-hero"
		showToc={headings.length > 0}
		headings={headings}
		like={{ slug: currentSlug, contentType: "wiki" }}
	/>
	<AnimateIn />
</BaseLayout>
