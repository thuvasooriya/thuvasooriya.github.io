---
import { type CollectionEntry, render } from "astro:content";
import Masthead from "@/components/content/Masthead.astro";
import PostLayout from "./Post.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { title, description, updated, published } = post.data;
const socialImage = `/og-image/${post.id}.png`;
const articleDate = updated?.toISOString() ?? published.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;
---

<PostLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
	headings={headings}
	heroId="blog-hero"
	likeButton={{ slug: post.id, contentType: "post" }}
>
	<Masthead slot="hero" content={post} readingTime={readingTime} postId={post.id} />
	<slot />
</PostLayout>
